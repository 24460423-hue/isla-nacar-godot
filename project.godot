config_version=5
[application]
config/name="Isla Nácar"
config/description="Recupera doce fragmentos de luz y enciende el faro de la isla."
run/main_scene="res://alumno/principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://alumno/recursos/icono.svg"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.16,0.37,0.43,1)
